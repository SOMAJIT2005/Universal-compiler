{
  "name": "offline-cpp-runner",
  "displayName": "Offline Code Runner",
  "description": "Bundled Windows C/C++, Python and Java runner. No separate compiler installation.",
  "version": "1.1.0",
  "publisher": "cpp-runner",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "offline-cpp-runner.run",
        "title": "Run C/C++/Python/Java Code",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "offline-cpp-runner.run",
          "when": "isWorkspaceTrusted && (resourceLangId == c || resourceLangId == cpp || resourceLangId == python || resourceLangId == java)",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^2.21.0",
    "axios": "^1.6.0",
    "adm-zip": "^0.5.10"
  },
  "scripts": {
    "test": "node --test test/runner.test.js test/extension.test.js test/bundle.test.js",
    "build-product": "node setup.js",
    "test:windows": "node scripts/smoke-windows.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Running code requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "author": {
    "name": "Somajit Deb"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SOMAJIT2005/Universal-compiler.git"
  }
}
